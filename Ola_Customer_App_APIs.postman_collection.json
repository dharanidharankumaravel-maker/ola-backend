            ],
            "url": { "raw": "{{baseUrl}}/rides/estimates", "host": ["{{baseUrl}}"], "path": ["rides", "estimates"] },
            "body": { "mode": "raw", "raw": "{\n  \"pickup\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707\n  },\n  \"destination\": {\n    \"latitude\": 13.0500,\n    \"longitude\": 80.2824\n  },\n  \"category\": \"rentals\",\n  \"rentalHours\": 4\n}" }
