    {
      "name": "Module 6 — Ride Lifecycle & Booking",
      "item": [
        {
          "name": "6.1 Book a Ride",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "if (res.success && res.data) {",
                "  pm.collectionVariables.set('rideId', res.data.rideId);",
                "  pm.test('Ride booked', function() { pm.expect(res.data.status).to.eql('requested'); });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/rides/book", "host": ["{{baseUrl}}"], "path": ["rides", "book"] },
            "body": { "mode": "raw", "raw": "{\n  \"pickup\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707,\n    \"formattedAddress\": \"Anna Salai, Chennai, Tamil Nadu\"\n  },\n  \"destination\": {\n    \"latitude\": 12.9941,\n    \"longitude\": 80.1709,\n    \"formattedAddress\": \"Chennai Airport, Tirusulam, Chennai\"\n  },\n  \"vehicleType\": \"sedan\",\n  \"category\": \"daily\",\n  \"paymentMethod\": \"cash\",\n  \"tipAmount\": 20\n}" }
          }
        },
        {
          "name": "6.1b Book Scheduled Ride",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/rides/book", "host": ["{{baseUrl}}"], "path": ["rides", "book"] },
            "body": { "mode": "raw", "raw": "{\n  \"pickup\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707,\n    \"formattedAddress\": \"Anna Salai, Chennai\"\n  },\n  \"destination\": {\n    \"latitude\": 12.9941,\n    \"longitude\": 80.1709,\n    \"formattedAddress\": \"Chennai Airport\"\n  },\n  \"vehicleType\": \"suv\",\n  \"category\": \"outstation\",\n  \"paymentMethod\": \"wallet\",\n  \"scheduledAt\": \"2026-10-08T06:00:00Z\"\n}" }
          }
        },
        {
          "name": "6.2 Get Current Active Ride",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/rides/current", "host": ["{{baseUrl}}"], "path": ["rides", "current"] }
          }
        },
        {
          "name": "6.3 Update Tip Amount",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/rides/{{rideId}}/tip", "host": ["{{baseUrl}}"], "path": ["rides", "{{rideId}}", "tip"] },
            "body": { "mode": "raw", "raw": "{\n  \"tipAmount\": 50\n}" }
          }
        },
        {
          "name": "6.4 Cancel Ride",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/rides/{{rideId}}/cancel", "host": ["{{baseUrl}}"], "path": ["rides", "{{rideId}}", "cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Change of plans\"\n}" }
          }
        },
        {
          "name": "6.5 Ride History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/rides/history?page=1&limit=10&status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["rides", "history"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "10" },
                { "key": "status", "value": "completed" }
              ]
            }
          }
        },
        {
          "name": "6.5b Cancelled Rides History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/rides/history?page=1&limit=10&status=cancelled",
              "host": ["{{baseUrl}}"],
              "path": ["rides", "history"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "10" },
                { "key": "status", "value": "cancelled" }
              ]
            }
          }
        },
        {
          "name": "6.6a Get Scheduled Rides",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/rides/scheduled", "host": ["{{baseUrl}}"], "path": ["rides", "scheduled"] }
          }
        },
        {
          "name": "6.6b Cancel Scheduled Ride",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/rides/scheduled/{{rideId}}", "host": ["{{baseUrl}}"], "path": ["rides", "scheduled", "{{rideId}}"] }
          }
        },
        {
          "name": "6.7 Get Ride Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/rides/{{rideId}}", "host": ["{{baseUrl}}"], "path": ["rides", "{{rideId}}"] }
          }
        }
      ]
    },
    {
