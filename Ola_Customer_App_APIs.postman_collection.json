{
  "info": {
    "_postman_id": "ola-clone-customer-api-v2",
    "name": "Ola Clone — Customer App APIs",
    "description": "Complete Customer App API collection for the Ola Clone platform.\n\nBase URL: {{baseUrl}}\n\nAuthentication: Bearer token (set via 'Login / Verify OTP' request which auto-sets {{accessToken}} and {{refreshToken}} variables).\n\n**Modules:**\n1. Authentication & Onboarding\n2. User Profile & Account Settings\n3. Map, Places & Locations\n4. Real-time Ghost Cars & Nearby Drivers\n5. Fare Estimates & Promo Offers\n6. Ride Lifecycle & Booking\n7. Alo Parcel (Delivery Service)\n8. Alo Money (Wallet) & Payments\n9. Ratings & Feedback\n10. Safety & Emergency (SOS)\n11. Support & FAQs\n12. Push Notification Device Registration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8000/api", "type": "string" },
    { "key": "accessToken",  "value": "",                          "type": "string" },
    { "key": "refreshToken", "value": "",                          "type": "string" },
    { "key": "rideId",       "value": "",                          "type": "string" },
    { "key": "savedPlaceId", "value": "",                          "type": "string" }
  ],
  "item": [
    {
      "name": "Module 1 — Authentication",
      "item": [
        {
          "name": "1.1 Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/otp/send", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "send"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876543210\",\n  \"fcm_key\": \"fcm_test_token_abc123\"\n}" }
          }
        },
        {
          "name": "1.2 Verify OTP & Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "if (res.success && res.data) {",
                "  pm.collectionVariables.set('accessToken',  res.data.tokens.accessToken);",
                "  pm.collectionVariables.set('refreshToken', res.data.tokens.refreshToken);",
                "  pm.test('Tokens saved', function() { pm.expect(res.data.tokens.accessToken).to.not.be.empty; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "verify"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"1234\",\n  \"fcm_key\": \"fcm_test_token_abc123\",\n  \"device_name\": \"Pixel 7\",\n  \"device_type\": \"smartphone\",\n  \"device_os\": \"Android 14\"\n}" }
          }
        },
        {
          "name": "1.3 Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "1.4 Get Me (Current User)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "1.5 Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Module 2 — User Profile & Account Settings",
      "item": [
        {
          "name": "2.0 Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] }
          }
        },
        {
          "name": "2.1 Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"avatarId\": \"Felix\",\n  \"emergency_contact\": \"+919123456789\"\n}"
            }
          }
        },
        {
          "name": "2.1b Update Profile with Photo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name",   "value": "Aarav Sharma", "type": "text" },
                { "key": "avatar", "value": "",              "type": "file", "src": "/path/to/photo.jpg" }
              ]
            }
          }
        },
        {
          "name": "2.2 Update Notification & Location Preferences",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/preferences", "host": ["{{baseUrl}}"], "path": ["users", "preferences"] },
            "body": { "mode": "raw", "raw": "{\n  \"notifications\": {\n    \"rideUpdates\": true,\n    \"promotions\": true,\n    \"sosAlerts\": true,\n    \"appUpdates\": false\n  },\n  \"location\": {\n    \"shareWithDriver\": true,\n    \"highAccuracyMode\": true,\n    \"backgroundTracking\": false\n  }\n}" }
          }
        },
        {
          "name": "2.3 Set Emergency Contact",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/emergency-contact", "host": ["{{baseUrl}}"], "path": ["users", "emergency-contact"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9123456789\"\n}" }
          }
        },
        {
          "name": "2.4 Delete Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/account", "host": ["{{baseUrl}}"], "path": ["users", "account"] }
          }
        }
      ]
    },
    {
      "name": "Module 3 — Map, Places & Locations",
      "item": [
        {
          "name": "3.1 Place Search / Autocomplete",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/map/search?q=Chennai&latitude=13.0827&longitude=80.2707&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["map", "search"],
              "query": [
                { "key": "q",         "value": "Chennai" },
                { "key": "latitude",  "value": "13.0827" },
                { "key": "longitude", "value": "80.2707" },
                { "key": "limit",     "value": "8" }
              ]
            }
          }
        },
        {
          "name": "3.2 Reverse Geocoding",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/map/reverse-geocode?lat=13.0827&lng=80.2707",
              "host": ["{{baseUrl}}"],
              "path": ["map", "reverse-geocode"],
              "query": [
                { "key": "lat", "value": "13.0827" },
                { "key": "lng", "value": "80.2707" }
              ]
            }
          }
        },
        {
          "name": "3.3 Calculate Route & Polyline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/map/route", "host": ["{{baseUrl}}"], "path": ["map", "route"] },
            "body": { "mode": "raw", "raw": "{\n  \"origin\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707\n  },\n  \"destination\": {\n    \"latitude\": 12.9941,\n    \"longitude\": 80.1709\n  }\n}" }
          }
        },
        {
          "name": "3.4a Get Saved Places",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/saved-places", "host": ["{{baseUrl}}"], "path": ["users", "saved-places"] }
          }
        },
        {
          "name": "3.4b Add Saved Place",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "if (res.success && res.data) {",
                "  pm.collectionVariables.set('savedPlaceId', res.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/saved-places", "host": ["{{baseUrl}}"], "path": ["users", "saved-places"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Home\",\n  \"subtitle\": \"No 42, Anna Salai, Chennai\",\n  \"location\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707,\n    \"formattedAddress\": \"No 42, Anna Salai, Chennai, Tamil Nadu 600002\",\n    \"shortAddress\": \"Anna Salai\"\n  }\n}" }
          }
        },
        {
          "name": "3.4c Delete Saved Place",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/saved-places/{{savedPlaceId}}", "host": ["{{baseUrl}}"], "path": ["users", "saved-places", "{{savedPlaceId}}"] }
          }
        }
      ]
    },
