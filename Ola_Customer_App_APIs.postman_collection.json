            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/rides/estimates", "host": ["{{baseUrl}}"], "path": ["rides", "estimates"] },
            "body": { "mode": "raw", "raw": "{\n  \"pickup\": {\n    \"latitude\": 13.0827,\n    \"longitude\": 80.2707\n  },\n  \"destination\": {\n    \"latitude\": 12.9941,\n    \"longitude\": 80.1709\n  },\n  \"category\": \"daily\"\n}" }
          }
        },
        {
          "name": "5.1b Rental Fare Estimate",
          "request": {
